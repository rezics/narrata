{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookView",
  "description": "Authoritative read model shared by browser transports and generated TypeScript validation.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "graphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GraphAnalysis"
      }
    },
    "view": {
      "$ref": "#/$defs/SessionView"
    }
  },
  "additionalProperties": false,
  "required": [
    "view",
    "graphs",
    "diagnostics"
  ],
  "$defs": {
    "ActionView": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "enabled"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "EdgeAnalysis": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/NodeAddress"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "target"
      ]
    },
    "FrameView": {
      "type": "object",
      "properties": {
        "graph": {
          "$ref": "#/$defs/GraphRef"
        },
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "locals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableView"
          }
        },
        "node": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableView"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "graph",
        "node",
        "instance",
        "parameters",
        "locals"
      ]
    },
    "GraphAnalysis": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeAnalysis"
          }
        },
        "reference": {
          "$ref": "#/$defs/GraphRef"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "reference",
        "title",
        "entry",
        "nodes"
      ]
    },
    "GraphRef": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph"
      ]
    },
    "HistoryView": {
      "type": "object",
      "properties": {
        "current": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "node": {
          "$ref": "#/$defs/NodeAddress"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "node",
        "instance",
        "current"
      ]
    },
    "NodeAddress": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph",
        "node"
      ]
    },
    "NodeAnalysis": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EdgeAnalysis"
          }
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "type_id",
        "label",
        "edges"
      ]
    },
    "ScalarType": {
      "type": "string",
      "enum": [
        "bool",
        "int",
        "text"
      ]
    },
    "SessionView": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionView"
          }
        },
        "artifact_id": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "finished": {
          "type": "boolean"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameView"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryView"
          }
        },
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "node": {
          "$ref": "#/$defs/NodeAddress"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_title": {
          "type": "string"
        },
        "shared": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableView"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "cursor",
        "product_title",
        "node",
        "instance",
        "title",
        "paragraphs",
        "actions",
        "finished",
        "shared",
        "frames",
        "history"
      ]
    },
    "VariableView": {
      "description": "Scalar payloads are formatted strings, so 64-bit integers never lose precision in JavaScript.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ScalarType"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "kind",
        "value"
      ]
    }
  }
}
