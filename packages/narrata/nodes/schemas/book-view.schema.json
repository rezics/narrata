{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookView",
  "description": "What the browser reader receives: the session view, the reading page of the current\npassage, and the text-free graph analysis.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "graphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GraphAnalysis"
      }
    },
    "page": {
      "description": "The presentation of the step that entered the current passage (or ended the story),\nfollowed by those of the local choices made in it since.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PresentationItem"
      }
    },
    "view": {
      "$ref": "#/$defs/SessionView"
    }
  },
  "additionalProperties": false,
  "required": [
    "view",
    "page",
    "graphs",
    "diagnostics"
  ],
  "$defs": {
    "AnchorId": {
      "type": "string",
      "pattern": "^[ -~]{1,128}$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^artifact:[0-9a-f]{64}$"
    },
    "ChoicePointId": {
      "type": "string",
      "pattern": "^choice-point:[0-9a-f]{32}$"
    },
    "CommitId": {
      "type": "string",
      "pattern": "^commit:[0-9a-f]{64}$"
    },
    "ContentKey": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ContentKey"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "key"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "EdgeAnalysis": {
      "type": "object",
      "properties": {
        "key": {
          "description": "An option alias, an outcome name, or `true`/`false` for conditions.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/EdgeKind"
        },
        "label": {
          "description": "An option label.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/NodeAddress"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ]
    },
    "EdgeKind": {
      "type": "string",
      "enum": [
        "next",
        "choice",
        "condition",
        "return",
        "call"
      ]
    },
    "ExecutionId": {
      "type": "string",
      "pattern": "^execution:[0-9a-f]{32}$"
    },
    "FrameView": {
      "type": "object",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoicePointId"
            },
            {
              "type": "null"
            }
          ]
        },
        "graph": {
          "$ref": "#/$defs/GraphRef"
        },
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "locals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableView"
          }
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableView"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "graph",
        "node",
        "instance",
        "parameters",
        "locals"
      ]
    },
    "GraphAnalysis": {
      "type": "object",
      "properties": {
        "entry": {
          "$ref": "#/$defs/NodeId"
        },
        "exported": {
          "type": "boolean"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeAnalysis"
          }
        },
        "reference": {
          "$ref": "#/$defs/GraphRef"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "reference",
        "entry",
        "exported",
        "nodes"
      ]
    },
    "GraphRef": {
      "description": "A graph of one package instance. Package aliases and graph names are composition\nstructure, so unlike node aliases they are part of the artifact identity.",
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph"
      ]
    },
    "HistoryView": {
      "type": "object",
      "properties": {
        "current": {
          "type": "boolean"
        },
        "depth": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "finished": {
          "type": "boolean"
        },
        "graph": {
          "description": "Where the commit waits, or the node that finished the story.",
          "$ref": "#/$defs/GraphRef"
        },
        "id": {
          "$ref": "#/$defs/CommitId"
        },
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "The waiting passage's title, or the ending's title.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "depth",
        "graph",
        "node",
        "instance",
        "finished",
        "current"
      ]
    },
    "Interaction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "args": {
              "description": "Arguments for option labels and disabled reasons.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ViewScalar"
              }
            },
            "choice_point": {
              "$ref": "#/$defs/ChoicePointId"
            },
            "graph": {
              "$ref": "#/$defs/GraphRef"
            },
            "key": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "choose"
            },
            "max": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            },
            "options": {
              "description": "Visible options in order; hidden ones are left out.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionView"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "graph",
            "node",
            "choice_point",
            "min",
            "max",
            "args",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "body": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Segment"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "finished"
            },
            "outcome": {
              "type": "string"
            },
            "title": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "outcome"
          ]
        }
      ]
    },
    "NodeAddress": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph",
        "node"
      ]
    },
    "NodeAnalysis": {
      "type": "object",
      "properties": {
        "callee": {
          "description": "The graph a call runs.",
          "anyOf": [
            {
              "$ref": "#/$defs/GraphRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EdgeAnalysis"
          }
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "outcome": {
          "description": "The outcome a return reports.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "A passage's title.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "edges"
      ]
    },
    "NodeId": {
      "type": "string",
      "pattern": "^node:[0-9a-f]{32}$"
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "passage",
        "branch",
        "mutate",
        "call",
        "return"
      ]
    },
    "OptionId": {
      "type": "string",
      "pattern": "^option:[0-9a-f]{32}$"
    },
    "OptionView": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/OptionId"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/OutcomeKind"
        },
        "reason": {
          "description": "Only for a disabled option that declares a reason.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "outcome"
      ]
    },
    "OutcomeKind": {
      "type": "string",
      "enum": [
        "local",
        "branch"
      ]
    },
    "PresentationItem": {
      "description": "One item to present. `(execution, commit, occurrence)` is the presentation key that\ngenerative content providers cache by.",
      "type": "object",
      "properties": {
        "args": {
          "description": "The passage's named arguments when the item was presented.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ViewScalar"
          }
        },
        "commit": {
          "description": "The commit whose step presented the item.",
          "$ref": "#/$defs/CommitId"
        },
        "content": {
          "$ref": "#/$defs/Presented"
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "occurrence": {
          "description": "The item's position in that commit's presentation.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      },
      "additionalProperties": false,
      "required": [
        "commit",
        "occurrence",
        "role",
        "node",
        "content",
        "args"
      ]
    },
    "Presented": {
      "description": "A title is a reference; body and reply items are segments.",
      "anyOf": [
        {
          "$ref": "#/$defs/Segment"
        },
        {
          "$ref": "#/$defs/ContentRef"
        }
      ]
    },
    "ProductView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ProviderId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "Role": {
      "type": "string",
      "enum": [
        "title",
        "body",
        "reply"
      ]
    },
    "Segment": {
      "type": "object",
      "properties": {
        "first": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit"
      ]
    },
    "SessionView": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "cursor": {
          "$ref": "#/$defs/CommitId"
        },
        "depth": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "execution": {
          "$ref": "#/$defs/ExecutionId"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameView"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryView"
          }
        },
        "interaction": {
          "$ref": "#/$defs/Interaction"
        },
        "presentation": {
          "description": "What to show since the previous interaction, recomputed from the parent state and the\ninput rather than stored.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresentationItem"
          }
        },
        "product": {
          "$ref": "#/$defs/ProductView"
        },
        "shared": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableView"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "execution",
        "cursor",
        "depth",
        "product",
        "presentation",
        "interaction",
        "shared",
        "frames",
        "history"
      ]
    },
    "VariableView": {
      "type": "object",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ViewScalar"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    },
    "ViewScalar": {
      "description": "Exchange form of a value. Integers are decimal strings so that 64-bit values survive\nJavaScript; `ref` values are resolved by the host's content provider.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "int"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ref"
            },
            "value": {
              "$ref": "#/$defs/ContentRef"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    }
  }
}
