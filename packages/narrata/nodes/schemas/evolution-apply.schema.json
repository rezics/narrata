{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplyV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "migrated"
        },
        "migration_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "report": {
          "$ref": "#/$defs/MigrationReportV1"
        },
        "source_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "target_artifact": {
          "$ref": "#/$defs/ArtifactId"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "source_commit",
        "migration_commit",
        "target_artifact",
        "report"
      ]
    },
    {
      "type": "object",
      "properties": {
        "actual_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CursorV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "const": "conflict"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "plan_changed"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "diagnostic": {
          "$ref": "#/$defs/Diagnostic"
        },
        "kind": {
          "type": "string",
          "const": "failed"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "diagnostic"
      ]
    }
  ],
  "$defs": {
    "ArtifactId": {
      "type": "string",
      "pattern": "^artifact:[0-9a-f]{64}$"
    },
    "AuthoredId": {
      "type": "string",
      "pattern": "^(node|choice-point|option):[0-9a-f]{32}$"
    },
    "ChoicePointId": {
      "type": "string",
      "pattern": "^choice-point:[0-9a-f]{32}$"
    },
    "CommitId": {
      "type": "string",
      "pattern": "^commit:[0-9a-f]{64}$"
    },
    "CursorRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "CursorV1": {
      "type": "object",
      "properties": {
        "commit": {
          "$ref": "#/$defs/CommitId"
        },
        "revision": {
          "$ref": "#/$defs/CursorRevision"
        }
      },
      "additionalProperties": false,
      "required": [
        "commit",
        "revision"
      ]
    },
    "DeletedId": {
      "description": "Only continuation positions can declare recovery; options cannot relocate a state.",
      "anyOf": [
        {
          "$ref": "#/$defs/NodeId"
        },
        {
          "$ref": "#/$defs/ChoicePointId"
        }
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "DiscardedFrameV1": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "local_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "overlay_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoredId"
          }
        },
        "parameter_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoicePointId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "node",
        "local_keys",
        "parameter_keys",
        "overlay_ids"
      ]
    },
    "DivergenceReason": {
      "type": "string",
      "enum": [
        "initial_state",
        "invalid_input",
        "execution",
        "semantic_state",
        "control_trace"
      ]
    },
    "ExternalEffectsV1": {
      "type": "string",
      "enum": [
        "not_applicable"
      ]
    },
    "GraphRef": {
      "description": "A graph of one package instance. Package aliases and graph names are composition\nstructure, so unlike node aliases they are part of the artifact identity.",
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph"
      ]
    },
    "LocationV1": {
      "type": "object",
      "properties": {
        "choice_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoicePointId"
            },
            {
              "type": "null"
            }
          ]
        },
        "graph": {
          "$ref": "#/$defs/GraphRef"
        },
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        }
      },
      "additionalProperties": false,
      "required": [
        "graph",
        "node",
        "instance"
      ]
    },
    "MigrationReportV1": {
      "type": "object",
      "properties": {
        "external_effects": {
          "$ref": "#/$defs/ExternalEffectsV1"
        },
        "from_artifact": {
          "$ref": "#/$defs/ArtifactId"
        },
        "losses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryLossV1"
          }
        },
        "migration_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "path": {
          "$ref": "#/$defs/PathComparisonV1"
        },
        "source_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "to_artifact": {
          "$ref": "#/$defs/ArtifactId"
        }
      },
      "additionalProperties": false,
      "required": [
        "from_artifact",
        "to_artifact",
        "source_commit",
        "migration_commit",
        "losses",
        "path",
        "external_effects"
      ]
    },
    "NodeId": {
      "type": "string",
      "pattern": "^node:[0-9a-f]{32}$"
    },
    "ObjectId": {
      "type": "string",
      "pattern": "^object:[0-9a-f]{64}$"
    },
    "PathComparisonV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "equivalent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "differing_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "input_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ObjectId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "diverged"
            },
            "new_location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LocationV1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "old_location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LocationV1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "$ref": "#/$defs/DivergenceReason"
            },
            "source_commit": {
              "$ref": "#/$defs/CommitId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source_commit",
            "reason",
            "differing_fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "baseline": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CommitId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked_through": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CommitId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "unverified"
            },
            "reason": {
              "$ref": "#/$defs/UnverifiedReason"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ]
        }
      ]
    },
    "RecoveryLossV1": {
      "type": "object",
      "properties": {
        "cleared_finished": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "discarded_frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscardedFrameV1"
          }
        },
        "reset_local_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retained_shared_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "$ref": "#/$defs/RecoveryTarget"
        },
        "tombstones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeletedId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tombstones",
        "discarded_frames",
        "retained_shared_keys",
        "reset_local_keys",
        "target"
      ]
    },
    "RecoveryTarget": {
      "type": "object",
      "properties": {
        "choice_point": {
          "$ref": "#/$defs/ChoicePointId"
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "choice_point"
      ]
    },
    "UnverifiedReason": {
      "type": "string",
      "enum": [
        "missing_ancestor",
        "missing_artifact",
        "missing_descriptor",
        "limit",
        "baseline",
        "trace_unavailable"
      ]
    }
  }
}
