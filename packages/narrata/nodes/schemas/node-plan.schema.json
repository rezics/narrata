{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourcePlan",
  "description": "What an authoring node type lowers to; every variant is then checked in its graph.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "args": {
          "description": "Named arguments the content provider formats text with.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          }
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Segment"
            },
            {
              "type": "null"
            }
          ]
        },
        "choice_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoicePointSource"
          }
        },
        "kind": {
          "type": "string",
          "const": "passage"
        },
        "next": {
          "description": "Alias of the node that follows when the passage runs to its end.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "condition": {
          "$ref": "#/$defs/Expr"
        },
        "kind": {
          "type": "string",
          "const": "branch"
        },
        "when_false": {
          "type": "string"
        },
        "when_true": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "condition",
        "when_true",
        "when_false"
      ]
    },
    {
      "type": "object",
      "properties": {
        "assignments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Assignment"
          }
        },
        "kind": {
          "type": "string",
          "const": "mutate"
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "next"
      ]
    },
    {
      "type": "object",
      "properties": {
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          },
          "default": {}
        },
        "kind": {
          "type": "string",
          "const": "call"
        },
        "on_return": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "target": {
          "$ref": "#/$defs/CallTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "on_return"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "return"
        },
        "outcome": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome"
      ]
    }
  ],
  "$defs": {
    "AnchorId": {
      "type": "string",
      "pattern": "^[ -~]{1,128}$"
    },
    "Assignment": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/Variable"
        },
        "value": {
          "$ref": "#/$defs/Expr"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "value"
      ]
    },
    "BinaryOp": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge",
        "add",
        "sub",
        "and",
        "or"
      ]
    },
    "CallTarget": {
      "oneOf": [
        {
          "description": "A graph of the same package instance.",
          "type": "object",
          "properties": {
            "graph": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "local"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "graph"
          ]
        },
        {
          "description": "An import port of the calling graph, bound by the product.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "import"
            },
            "port": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "port"
          ]
        }
      ]
    },
    "ChoicePointId": {
      "type": "string",
      "pattern": "^choice-point:[0-9a-f]{32}$"
    },
    "ChoicePointSource": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoicePointId"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "string"
        },
        "max": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionSource"
          }
        },
        "placement": {
          "description": "The body block after which the choice point appears; only the last one may omit it.",
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposals": {
          "description": "Reserved for host proposals (ADR 0013 §5); not supported yet.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "options"
      ]
    },
    "ContentKey": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ContentKey"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "key"
      ]
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/Scalar"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "read"
            },
            "name": {
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not"
            },
            "value": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binary"
            },
            "left": {
              "$ref": "#/$defs/Expr"
            },
            "op": {
              "$ref": "#/$defs/BinaryOp"
            },
            "right": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "op",
            "left",
            "right"
          ]
        }
      ]
    },
    "OptionId": {
      "type": "string",
      "pattern": "^option:[0-9a-f]{32}$"
    },
    "OptionSource": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assignment"
          }
        },
        "enabled_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OptionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/OutcomeSource"
        },
        "reason": {
          "description": "Shown when the option is visible but disabled.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "outcome"
      ]
    },
    "OutcomeSource": {
      "oneOf": [
        {
          "description": "Show `reply`, then continue in the same passage from `rejoin`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "rejoin": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnchorId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reply": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Segment"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Enter another node of the same graph, by alias.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "branch"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        }
      ]
    },
    "ProviderId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "Scalar": {
      "description": "A state value. `text` is data that rules compare (decision 2); translatable names travel as\n`ref`, which only supports equality.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ContentRef"
        }
      ]
    },
    "Scope": {
      "type": "string",
      "enum": [
        "parameter",
        "local",
        "shared"
      ]
    },
    "Segment": {
      "type": "object",
      "properties": {
        "first": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit"
      ]
    },
    "Variable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "name"
      ]
    }
  }
}
