{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectManifest",
  "description": "Resolved by tooling, never by the deterministic runtime.",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "migrated_from_r1": {
      "description": "The R1 artifact this work was migrated from; recorded in the name table so that R1\nsaves can only migrate onto it (ADR 0013 §10).",
      "anyOf": [
        {
          "$ref": "#/$defs/R1ArtifactId"
        },
        {
          "type": "null"
        }
      ]
    },
    "packages": {
      "description": "Package instance alias to a path relative to the manifest.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "product": {
      "$ref": "#/$defs/ProductSource"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version",
    "product",
    "packages"
  ],
  "$defs": {
    "AnchorId": {
      "type": "string",
      "pattern": "^[ -~]{1,128}$"
    },
    "Binding": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/ImportRef"
        },
        "to": {
          "$ref": "#/$defs/GraphRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "ContentKey": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ContentKey"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "key"
      ]
    },
    "EndingSource": {
      "type": "object",
      "properties": {
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Segment"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GraphRef": {
      "description": "A graph of one package instance. Package aliases and graph names are composition\nstructure, so unlike node aliases they are part of the artifact identity.",
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph"
      ]
    },
    "ImportRef": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph",
        "port"
      ]
    },
    "ProductSource": {
      "type": "object",
      "properties": {
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "default": {}
        },
        "bindings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "endings": {
          "description": "How each outcome of the entry graph is shown when the story ends.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EndingSource"
          }
        },
        "entry": {
          "$ref": "#/$defs/GraphRef"
        },
        "id": {
          "type": "string"
        },
        "shared": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "default": {}
        },
        "shared_labels": {
          "description": "Display names of shared variables.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ContentRef"
          }
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "entry"
      ]
    },
    "ProviderId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "R1ArtifactId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Scalar": {
      "description": "A state value. `text` is data that rules compare (decision 2); translatable names travel as\n`ref`, which only supports equality.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ContentRef"
        }
      ]
    },
    "Segment": {
      "type": "object",
      "properties": {
        "first": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit"
      ]
    }
  }
}
