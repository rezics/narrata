{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProposalRequest",
  "description": "What a host proposes at the choice point the session waits at. It carries no IDs: existing\nnodes are named by `node:` ID and proposed ones by their key in this request.",
  "type": "object",
  "properties": {
    "choice_point": {
      "description": "The current choice point; it must accept proposals.",
      "$ref": "#/$defs/ChoicePointId"
    },
    "nodes": {
      "description": "Passages added to the current frame; they vanish when the frame returns.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodeProposal"
      }
    },
    "options": {
      "description": "Appended after the choice point's options, in this order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/OptionProposal"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "choice_point"
  ],
  "$defs": {
    "AnchorId": {
      "type": "string",
      "pattern": "^[ -~]{1,128}$"
    },
    "Assignment": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/Variable"
        },
        "value": {
          "$ref": "#/$defs/Expr"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "value"
      ]
    },
    "BinaryOp": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge",
        "add",
        "sub",
        "and",
        "or"
      ]
    },
    "ChoicePointId": {
      "type": "string",
      "pattern": "^choice-point:[0-9a-f]{32}$"
    },
    "ChoicePointProposal": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionProposal"
          }
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposals": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "options"
      ]
    },
    "ContentKey": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ContentKey"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "key"
      ]
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/Scalar"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "read"
            },
            "name": {
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not"
            },
            "value": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binary"
            },
            "left": {
              "$ref": "#/$defs/Expr"
            },
            "op": {
              "$ref": "#/$defs/BinaryOp"
            },
            "right": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "op",
            "left",
            "right"
          ]
        }
      ]
    },
    "NodeProposal": {
      "type": "object",
      "properties": {
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          }
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Segment"
            },
            {
              "type": "null"
            }
          ]
        },
        "choice_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoicePointProposal"
          }
        },
        "key": {
          "description": "Names the node within this request only; it is never recorded.",
          "type": "string"
        },
        "next": {
          "description": "A `node:` ID or the key of a node in this request, as for branch targets.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key"
      ]
    },
    "OptionProposal": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assignment"
          }
        },
        "enabled_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "description": "A branch target is a `node:` ID of the graph or of the frame's earlier proposals, or\nthe key of a node in this request.",
          "$ref": "#/$defs/OutcomeSource"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "outcome"
      ]
    },
    "OutcomeSource": {
      "oneOf": [
        {
          "description": "Show `reply`, then continue in the same passage from `rejoin`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "rejoin": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnchorId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reply": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Segment"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Enter another node of the same graph, by alias.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "branch"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        }
      ]
    },
    "ProviderId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "Scalar": {
      "description": "A state value. `text` is data that rules compare (decision 2); translatable names travel as\n`ref`, which only supports equality.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ContentRef"
        }
      ]
    },
    "Scope": {
      "type": "string",
      "enum": [
        "parameter",
        "local",
        "shared"
      ]
    },
    "Segment": {
      "type": "object",
      "properties": {
        "first": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit"
      ]
    },
    "Variable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "name"
      ]
    }
  }
}
