{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthoringInterface",
  "description": "Every exchanged shape, so one generated declaration file shares its definitions.",
  "type": "object",
  "properties": {
    "authored_id": {
      "$ref": "#/$defs/AuthoredId"
    },
    "lock": {
      "$ref": "#/$defs/CompositionLock"
    },
    "manifest": {
      "$ref": "#/$defs/ProjectManifest"
    },
    "minted_ids": {
      "$ref": "#/$defs/MintedIds"
    },
    "object_reference": {
      "$ref": "#/$defs/ObjectReference"
    },
    "outline": {
      "$ref": "#/$defs/ContentOutline"
    },
    "package": {
      "$ref": "#/$defs/PackageSource"
    },
    "preview_report": {
      "$ref": "#/$defs/PreviewReport"
    },
    "publication": {
      "$ref": "#/$defs/PublicationDescription"
    },
    "publish_report": {
      "$ref": "#/$defs/PublishReport"
    },
    "record": {
      "$ref": "#/$defs/DraftRecord"
    },
    "record_indexes": {
      "$ref": "#/$defs/RecordIndexes"
    },
    "record_report": {
      "$ref": "#/$defs/RecordReport"
    }
  },
  "required": [
    "record",
    "record_report",
    "record_indexes",
    "preview_report",
    "publish_report",
    "minted_ids",
    "publication",
    "object_reference",
    "outline",
    "manifest",
    "package",
    "lock",
    "authored_id"
  ],
  "$defs": {
    "AnchorId": {
      "type": "string",
      "pattern": "^[ -~]{1,128}$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^artifact:[0-9a-f]{64}$"
    },
    "Assignment": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/Variable"
        },
        "value": {
          "$ref": "#/$defs/Expr"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "value"
      ]
    },
    "AuthoredId": {
      "type": "string",
      "pattern": "^(node|choice-point|option):[0-9a-f]{32}$"
    },
    "BinaryOp": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge",
        "add",
        "sub",
        "and",
        "or"
      ]
    },
    "Binding": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/ImportRef"
        },
        "to": {
          "$ref": "#/$defs/GraphRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "ChoicePointId": {
      "type": "string",
      "pattern": "^choice-point:[0-9a-f]{32}$"
    },
    "ChoicePointSource": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoicePointId"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "string"
        },
        "max": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionSource"
          }
        },
        "placement": {
          "description": "The body block after which the choice point appears; only the last one may omit it.",
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposals": {
          "description": "Whether the host may propose options and passages here at run time (ADR 0013 §5).",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "options"
      ]
    },
    "ClusterId": {
      "type": "string",
      "pattern": "^cluster:[0-9a-f]{32}$"
    },
    "CompositionLock": {
      "description": "Written next to the project manifest as `project.lock.json`.",
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "format_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "node_types": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PackageLock"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "format_version",
        "artifact_id",
        "packages",
        "node_types"
      ]
    },
    "ContentKey": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "ContentOutline": {
      "description": "A content provider's outline (ADR 0013 §4): block order and choice-point markers of each\ncontent unit, without text. It lets `compose` check placement order without the documents.",
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[^\\u0000-\\u001f\\u007f-\\u009f]+$": {
              "$ref": "#/$defs/UnitOutline"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "format_version",
        "provider",
        "units"
      ]
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ContentKey"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "key"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "choice_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoicePointId"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "option": {
          "anyOf": [
            {
              "$ref": "#/$defs/OptionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "pointer": {
          "type": "string"
        },
        "record": {
          "type": [
            "string",
            "null"
          ]
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "pointer",
        "related",
        "message"
      ]
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DraftRecord": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format_version": {
              "$ref": "#/$defs/DraftVersion"
            },
            "kind": {
              "type": "string",
              "const": "project"
            },
            "payload": {
              "$ref": "#/$defs/ProjectManifest"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "format_version",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "format_version": {
              "$ref": "#/$defs/DraftVersion"
            },
            "kind": {
              "type": "string",
              "const": "package"
            },
            "package": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/PackageSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "format_version",
            "package",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "format_version": {
              "$ref": "#/$defs/DraftVersion"
            },
            "graph": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "graph"
            },
            "package": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/GraphSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "format_version",
            "package",
            "graph",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "choice_order": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/ChoicePointId"
              }
            },
            "format_version": {
              "$ref": "#/$defs/DraftVersion"
            },
            "graph": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "node"
            },
            "package": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/NodeSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "format_version",
            "package",
            "graph",
            "key",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "format_version": {
              "$ref": "#/$defs/DraftVersion"
            },
            "graph": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "choice_point"
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            },
            "package": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/ChoicePointSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "format_version",
            "package",
            "graph",
            "node",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "format_version": {
              "$ref": "#/$defs/DraftVersion"
            },
            "kind": {
              "type": "string",
              "const": "tombstone"
            },
            "package": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/AuthoredId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "format_version",
            "package",
            "payload"
          ]
        }
      ]
    },
    "DraftVersion": {
      "type": "integer",
      "const": 1
    },
    "Encoding": {
      "type": "string",
      "enum": [
        "cbor",
        "json"
      ]
    },
    "EndingSource": {
      "type": "object",
      "properties": {
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Segment"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/Scalar"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "read"
            },
            "name": {
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not"
            },
            "value": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binary"
            },
            "left": {
              "$ref": "#/$defs/Expr"
            },
            "op": {
              "$ref": "#/$defs/BinaryOp"
            },
            "right": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "op",
            "left",
            "right"
          ]
        }
      ]
    },
    "GraphFiles": {
      "description": "Bootstrap references for object-id-named files in the companion `.graph/` directory.",
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "format_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 1,
          "minimum": 1
        },
        "index_object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LabelObject"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "format_version",
        "artifact_id",
        "index_object_id",
        "labels"
      ]
    },
    "GraphRef": {
      "description": "A graph of one package instance. Package aliases and graph names are composition\nstructure, so unlike node aliases they are part of the artifact identity.",
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph"
      ]
    },
    "GraphSource": {
      "type": "object",
      "properties": {
        "entry": {
          "description": "Alias of the entry node.",
          "type": "string"
        },
        "imports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Signature"
          },
          "default": {}
        },
        "locals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "default": {}
        },
        "nodes": {
          "description": "Keyed by node alias.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NodeSource"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ScalarType"
          },
          "default": {}
        },
        "shared": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ScalarType"
          },
          "default": {}
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "outcomes",
        "entry",
        "nodes"
      ]
    },
    "ImportRef": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "package",
        "graph",
        "port"
      ]
    },
    "LabelObject": {
      "type": "object",
      "properties": {
        "cluster": {
          "$ref": "#/$defs/ClusterId"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "cluster",
        "object_id"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "choice_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoicePointId"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "option": {
          "anyOf": [
            {
              "$ref": "#/$defs/OptionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "pointer": {
          "type": "string"
        },
        "record": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "pointer"
      ]
    },
    "MintedIds": {
      "description": "Newly minted IDs; none of them occurred in the minter's occupied set.",
      "type": "object",
      "properties": {
        "choice_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoicePointId"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeId"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionId"
          }
        }
      },
      "required": [
        "nodes",
        "choice_points",
        "options"
      ]
    },
    "NodeId": {
      "type": "string",
      "pattern": "^node:[0-9a-f]{32}$"
    },
    "NodeSource": {
      "type": "object",
      "properties": {
        "data": true,
        "id": {
          "description": "Minted by `narrata-book ids`; compile rejects a missing ID.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "type_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type_id",
        "data"
      ]
    },
    "ObjectId": {
      "type": "string",
      "pattern": "^object:[0-9a-f]{64}$"
    },
    "ObjectReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "encoding": {
          "$ref": "#/$defs/Encoding"
        },
        "object_id": {
          "$ref": "#/$defs/Digest"
        },
        "role": {
          "$ref": "#/$defs/ObjectRole"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "object_id",
        "bytes",
        "encoding"
      ]
    },
    "ObjectRole": {
      "description": "Lexical role order is the descriptor order. Evolution is reserved for ADR 0023;\nthis publisher neither creates nor accepts unchecked evolution descriptors.",
      "type": "string",
      "enum": [
        "chunk",
        "evolution",
        "graph_index",
        "graph_tile",
        "labels",
        "manifest",
        "names",
        "relation_index",
        "relation_part",
        "summary",
        "tombstones"
      ]
    },
    "OptionId": {
      "type": "string",
      "pattern": "^option:[0-9a-f]{32}$"
    },
    "OptionIndex": {
      "type": "object",
      "properties": {
        "choice_point": {
          "$ref": "#/$defs/ChoicePointId"
        },
        "graph": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "option": {
          "$ref": "#/$defs/OptionId"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "outcome": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record": {
          "type": "string"
        },
        "rejoin": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply": {
          "anyOf": [
            {
              "$ref": "#/$defs/Segment"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentRef"
          }
        },
        "target_node": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_status": {
          "$ref": "#/$defs/TargetStatus"
        },
        "target_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record",
        "package",
        "graph",
        "node",
        "choice_point",
        "option",
        "ordinal",
        "outcome",
        "target_status",
        "tags"
      ]
    },
    "OptionSource": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assignment"
          }
        },
        "enabled_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OptionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/OutcomeSource"
        },
        "reason": {
          "description": "Shown when the option is visible but disabled.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "outcome"
      ]
    },
    "OutcomeSource": {
      "oneOf": [
        {
          "description": "Show `reply`, then continue in the same passage from `rejoin`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "rejoin": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnchorId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reply": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Segment"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Enter another node of the same graph, by alias.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "branch"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        }
      ]
    },
    "OwnershipIndex": {
      "type": "object",
      "properties": {
        "graph": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "record": {
          "type": "string"
        }
      },
      "required": [
        "record",
        "kind"
      ]
    },
    "PackageLock": {
      "type": "object",
      "properties": {
        "digest": {
          "description": "`digest_bytes(\"narrata.nodes.package-source\", 1, canonical JSON)`, hexadecimal.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ]
    },
    "PackageSource": {
      "type": "object",
      "properties": {
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graphs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/GraphSource"
          }
        },
        "id": {
          "type": "string"
        },
        "tombstones": {
          "description": "Deleted IDs; they are never reused, and the list only grows.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoredId"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "exports",
        "graphs"
      ]
    },
    "PreviewReport": {
      "description": "Preview compilation of records into program objects. A compiled preview is never a\npublication: switching requires `publish` with outlines.",
      "type": "object",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "compared": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositionLock"
            },
            {
              "type": "null"
            }
          ]
        },
        "objects": {
          "description": "Program chunks and the tombstone set, retrievable one at a time.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "tombstones": {
          "description": "Tombstone records the host persists atomically with the edit before publishing.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftRecord"
          }
        }
      },
      "required": [
        "complete",
        "diagnostics",
        "compared",
        "tombstones",
        "objects"
      ]
    },
    "ProductSource": {
      "type": "object",
      "properties": {
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "default": {}
        },
        "bindings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "endings": {
          "description": "How each outcome of the entry graph is shown when the story ends.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EndingSource"
          }
        },
        "entry": {
          "$ref": "#/$defs/GraphRef"
        },
        "id": {
          "type": "string"
        },
        "shared": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "default": {}
        },
        "shared_labels": {
          "description": "Display names of shared variables.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ContentRef"
          }
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "entry"
      ]
    },
    "ProjectManifest": {
      "description": "Resolved by tooling, never by the deterministic runtime.",
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "migrated_from_r1": {
          "description": "The R1 artifact this work was migrated from; recorded in the name table so that R1\nsaves can only migrate onto it (ADR 0013 §10).",
          "anyOf": [
            {
              "$ref": "#/$defs/R1ArtifactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "packages": {
          "description": "Package instance alias to a path relative to the manifest.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "product": {
          "$ref": "#/$defs/ProductSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "format_version",
        "product",
        "packages"
      ]
    },
    "ProviderId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "PublicationDescription": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evolution": {
          "description": "ADR 0023's full MigrationId digest, addressed by the evolution role.",
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "format_version": {
          "$ref": "#/$defs/Version1"
        },
        "graph": {
          "$ref": "#/$defs/GraphFiles"
        },
        "names": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectReference"
          }
        },
        "relation_index": {
          "$ref": "#/$defs/Digest"
        },
        "summary": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "format_version",
        "artifact_id",
        "graph",
        "summary",
        "relation_index",
        "objects"
      ]
    },
    "PublicationStatus": {
      "description": "Compiled candidates can be retained and inspected even when their outlines prevent\nswitching. Topology warnings do not prevent switching; missing/defective outlines do.",
      "type": "string",
      "enum": [
        "compiled",
        "switchable"
      ]
    },
    "PublishReport": {
      "type": "object",
      "properties": {
        "candidate_artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "compared": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositionLock"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "description": "`compiled` candidates can be retained and inspected; only `switchable` ones pass the\noutline policy for becoming the work's current publication.",
          "anyOf": [
            {
              "$ref": "#/$defs/PublicationStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "tombstones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftRecord"
          }
        }
      },
      "required": [
        "complete",
        "diagnostics",
        "compared",
        "tombstones"
      ]
    },
    "R1ArtifactId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "RecordIndexes": {
      "description": "The derived index rows of one record, replaced together with its payload.",
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionIndex"
          }
        },
        "ownership": {
          "$ref": "#/$defs/OwnershipIndex"
        }
      },
      "required": [
        "ownership",
        "options"
      ]
    },
    "RecordReport": {
      "description": "A checked record set, a single checked record or a split source. `records` counts the\nrecords available by index; it is zero whenever an error prevented a checked value.",
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "minted": {
          "description": "IDs this operation minted, in allocation order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoredId"
          }
        },
        "records": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "complete",
        "diagnostics",
        "records",
        "minted"
      ]
    },
    "Scalar": {
      "description": "A state value. `text` is data that rules compare (decision 2); translatable names travel as\n`ref`, which only supports equality.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ContentRef"
        }
      ]
    },
    "ScalarType": {
      "type": "string",
      "enum": [
        "bool",
        "int",
        "text",
        "ref"
      ]
    },
    "Scope": {
      "type": "string",
      "enum": [
        "parameter",
        "local",
        "shared"
      ]
    },
    "Segment": {
      "type": "object",
      "properties": {
        "first": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "Signature": {
      "description": "Parameters and outcomes; checked signatures keep outcomes sorted and unique.",
      "type": "object",
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ScalarType"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "outcomes"
      ]
    },
    "TargetStatus": {
      "type": "string",
      "enum": [
        "local",
        "passage",
        "control",
        "unresolved"
      ]
    },
    "UnitOutline": {
      "type": "object",
      "properties": {
        "blocks": {
          "description": "Every block anchor in document order, markers included.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnchorId"
          }
        },
        "markers": {
          "description": "Marker blocks and the choice point each one stands for.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[ -~]{1,128}$": {
              "$ref": "#/$defs/ChoicePointId"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "blocks"
      ]
    },
    "Variable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "name"
      ]
    },
    "Version1": {
      "type": "integer",
      "const": 1
    }
  }
}
