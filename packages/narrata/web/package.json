{
  "name": "@rezics/narrata",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Narrata's Gamebook reader runtime, authoring and publication Wasm, and IndexedDB save host.",
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    "size-budget.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reader": {
      "types": "./dist/reader/index.d.ts",
      "import": "./dist/reader/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./graph/react": {
      "types": "./dist/graph/react.d.ts",
      "import": "./dist/graph/react.js"
    },
    "./reader-map": {
      "types": "./dist/graph/reader-map.d.ts",
      "import": "./dist/graph/reader-map.js"
    },
    "./reader-map/react": {
      "types": "./dist/graph/reader-map-react.d.ts",
      "import": "./dist/graph/reader-map-react.js"
    },
    "./content/native": {
      "types": "./dist/content/native.d.ts",
      "import": "./dist/content/native.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "pack:artifact": "node scripts/pack.mjs",
    "test:install": "node scripts/install-test.mjs",
    "budget": "node scripts/budget.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "fake-indexeddb": "6.2.5",
    "json-schema-to-typescript": "16.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rolldown": "1.2.12",
    "typescript": "~5.9.3",
    "vite": "8.2.4",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "graphology": "0.26.0",
    "sigma": "3.0.3"
  }
}
