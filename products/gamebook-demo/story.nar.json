                        },
                        "value": {
                          "kind": "binary",
                          "left": {
                            "kind": "read",
                            "name": "rations",
                            "scope": "shared"
                          },
                          "op": "sub",
                          "right": {
                            "kind": "literal",
                            "value": 1
                          }
                        }
                      },
                      {
                        "target": {
                          "name": "helped",
                          "scope": "shared"
                        },
                        "value": {
                          "kind": "literal",
                          "value": true
                        }
                      }
                    ],
                    "disabled_reason": "至少需要一份干粮",
                    "enabled_if": {
                      "kind": "binary",
                      "left": {
                        "kind": "read",
                        "name": "rations",
                        "scope": "shared"
                      },
                      "op": "gt",
                      "right": {
                        "kind": "literal",
                        "value": 0
                      }
                    },
                    "id": "help",
                    "label": "分给旅人一份干粮，请他带路",
                    "target": "trail"
                  },
                  {
                    "id": "alone",
                    "label": "独自沿旧路继续",
                    "target": "fog"
                  },
                  {
                    "id": "retreat",
                    "label": "先回驿站准备",
                    "target": "retreated"
                  }
                ],
                "content": "rocks"
              }
            },
            "trail": {
              "type_id": "narrata.content",
              "data": {
                "content": "trail",
                "label": "继续前往山口",
                "next": "crossed"
              }
            }
          }
        }
      }
    }
  }
}
